# DXReportApp Environment Configuration
# Copy this to .env and fill in real values before deploying

# ── Security ────────────────────────────────────────────────────────────────
# CHANGE THIS in production! Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dxreportapp_dev_secret_key_change_me_in_production_abc123xyz

# Access token lifetime in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── API ──────────────────────────────────────────────────────────────────────
# URL used by Streamlit to reach FastAPI
API_BASE_URL=http://127.0.0.1:8000

# ── Import settings ──────────────────────────────────────────────────────────
# Rows per CSV chunk (tune based on available RAM)
CSV_CHUNK_SIZE=10000

# Max upload file size in MB
MAX_UPLOAD_SIZE_MB=500
